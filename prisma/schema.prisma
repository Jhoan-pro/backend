generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(CLIENT)
  active    Boolean   @default(true)
  fullName  String?
  address   String?
  birthDate DateTime?
  idNumber  String?
  country   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  cart      Cart?
  orders    Order[]   @relation("OrderCashier")
  products  Product[] @relation("ProductOwner")

  @@map("users")
}

model Product {
  id          Int         @id @default(autoincrement())
  ownerId     Int?
  name        String
  price       Decimal     @db.Decimal(10, 2)
  stock       Int         @default(0)
  category    String
  description String
  image       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  cartItems   CartItem[]
  orderItems  OrderItem[]
  owner       User?       @relation("ProductOwner", fields: [ownerId], references: [id])

  @@index([category])
  @@map("products")
}

model Order {
  id                 Int           @id @default(autoincrement())
  invoiceNumber      String        @unique
  date               DateTime      @default(now())
  customerName       String
  customerEmail      String
  customerPhone      String
  customerAddress    String
  customerCity       String
  customerDocumentId String
  notes              String?
  cashierId          Int
  paymentMethod      PaymentMethod
  walletNumber       String?
  bank               String?
  reference          String?
  cardName           String?
  cardNumberLast4    String?
  total              Decimal       @db.Decimal(10, 2)
  createdAt          DateTime      @default(now())
  items              OrderItem[]
  cashier            User          @relation("OrderCashier", fields: [cashierId], references: [id])

  @@index([cashierId])
  @@map("orders")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int?
  ownerId   Int?
  name      String
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Cart {
  id           Int        @id @default(autoincrement())
  userId       Int        @unique
  lastActivity DateTime   @default(now())
  items        CartItem[]
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  productId Int
  cantidad  Int     @default(1)
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

enum Role {
  ADMIN     @map("admin")
  SUB_ADMIN @map("sub-admin")
  CASHIER   @map("cashier")
  CLIENT    @map("client")
}

enum PaymentMethod {
  CARD     @map("card")
  TRANSFER @map("transfer")
  WALLET   @map("wallet")
}
